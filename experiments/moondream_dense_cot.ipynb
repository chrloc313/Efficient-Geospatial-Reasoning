    "                \"reasoning_steps\": sample[\"synthesis_reasoning_steps\"],\n",
    "                \"final_answer\": sample[\"synthesis_final_answer\"],\n",
    "                \"confidence\": sample[\"synthesis_confidence\"]\n",
    "            },\n",
