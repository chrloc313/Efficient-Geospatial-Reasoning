    "                    \"grounding_objects\": geo_cot.get(\"grounding_objects\", []),\n",
    "                    \"grounding_spatial_relationships\": geo_cot.get(\"grounding_spatial_relationships\", []),\n",
    "                    \"grounding_flood_indicators\": geo_cot.get(\"grounding_flood_indicators\", []),\n",
    "                    \n",
    "                    # Synthesis phase\n",
    "                    \"synthesis_observations\": geo_cot.get(\"synthesis_observations\", []),\n",
    "                    \"synthesis_reasoning_steps\": geo_cot.get(\"synthesis_reasoning_steps\", []),\n",
    "                    \"synthesis_final_answer\": geo_cot.get(\"synthesis_final_answer\", \"\"),\n",
    "                    \"synthesis_confidence\": geo_cot.get(\"synthesis_confidence\", \"\"),\n",
    "                    \n",
    "                    # Full raw response if needed\n",
    "                    \"raw_response\": geo_cot.get(\"raw_response\", \"\")\n",
    "                })\n",
    "        \n",
    "        print(f\"  Loaded {len(self.samples)} samples with Geo-COT annotations from {img_dir.name}\")\n",
    "    \n",
    "    def __len__(self):\n",
    "        return len(self.samples)\n",
    "    \n",
    "    def __getitem__(self, idx):\n",
