   "source": [
    "## Step 8: Trainer Class (Cross-Entropy Loss)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {
    "id": "trainer"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Trainer initialized (lr=0.0002)\n"
     ]
    }
   ],
   "source": [
    "class MoondreamTrainer:\n",
    "    \"\"\"\n",
    "    Trainer for Moondream SFT with cross-entropy loss.\n",
    "    \"\"\"\n",
    "    def __init__(self, model, tokenizer, config: dict):\n",
    "        self.model = model\n",
    "        self.tokenizer = tokenizer\n",
    "        self.config = config\n",
    "        self.device = next(model.parameters()).device\n",
    "\n",
    "        trainable_params = [p for p in model.parameters() if p.requires_grad]\n",
    "        self.optimizer = AdamW(\n",
    "            trainable_params,\n",
    "            lr=config[\"learning_rate\"],\n",
    "            weight_decay=config[\"weight_decay\"]\n",
    "        )\n",
    "\n",
    "        self.scaler = GradScaler(\"cuda\")\n",
    "\n",
    "        self.current_step = 0\n",
    "\n",
    "        print(f\"✓ Trainer initialized (lr={config['learning_rate']})\")\n",
    "\n",
    "    def _get_lr(self) -> float:\n",
    "        \"\"\"Linear warmup then constant.\"\"\"\n",
    "        if self.current_step < self.config[\"warmup_steps\"]:\n",
    "            return self.config[\"learning_rate\"] * (self.current_step + 1) / self.config[\"warmup_steps\"]\n",
    "        return self.config[\"learning_rate\"]\n",
    "\n",
    "    def _update_lr(self):\n",
    "        lr = self._get_lr()\n",
    "        for pg in self.optimizer.param_groups:\n",
    "            pg[\"lr\"] = lr\n",
    "\n",
    "    def compute_loss(self, images, questions, reasonings, answers) -> torch.Tensor:\n",
    "        \"\"\"Compute cross-entropy loss for Geo-CoT training.\"\"\"\n",
    "        total_loss = 0.0\n",
    "        valid = 0\n",
    "    \n",
    "        for image, question, reasoning, answer in zip(images, questions, reasonings, answers):\n",
    "            try:\n",
    "                with torch.no_grad():\n",
    "                    image_embeds = self.model.encode_image(image)\n",
    "    \n",
    "                # IMPORTANT: Use consistent prompt format\n",
    "                prompt = f\"\\n\\nQuestion: {question}\\n\\nLet me analyze this step by step.\\n\\n\"\n",
    "                \n",
    "                # Target includes reasoning WITH tags + answer WITH tags\n",
    "                target_text = f\"{reasoning}\\n<answer>{answer}</answer>\"\n",
    "                \n",
    "                full_text = f\"{prompt}{target_text}\"\n",
    "    \n",
    "                prompt_ids = self.tokenizer.encode(prompt, add_special_tokens=False)\n",
    "                full_ids = self.tokenizer.encode(full_text, add_special_tokens=False)\n",
    "    \n",
    "                input_ids = torch.tensor([full_ids], device=self.device)\n",
    "                labels = input_ids.clone()\n",
    "                labels[0, :len(prompt_ids)] = -100  # Mask prompt\n",
    "    \n",
    "                text_embeds = self.model.text_model.get_input_embeddings()(input_ids)\n",
    "                inputs_embeds = torch.cat([image_embeds, text_embeds], dim=1)\n",
    "    \n",
    "                image_labels = torch.full(\n",
    "                    (1, image_embeds.shape[1]), -100, dtype=torch.long, device=self.device\n",
    "                )\n",
    "                labels = torch.cat([image_labels, labels], dim=1)\n",
    "    \n",
    "                outputs = self.model.text_model(\n",
    "                    inputs_embeds=inputs_embeds,\n",
    "                    labels=labels,\n",
    "                    return_dict=True\n",
    "                )\n",
    "    \n",
    "                total_loss += outputs.loss\n",
    "                valid += 1\n",
    "    \n",
    "            except Exception as e:\n",
    "                print(f\"Error: {e}\")\n",
    "                continue\n",
    "    \n",
    "        return total_loss / valid if valid > 0 else torch.tensor(0.0, device=self.device, requires_grad=True)\n",
    "\n",
    "    def train_step(self, batch: dict) -> float:\n",
    "        \"\"\"Single training step.\"\"\"\n",
    "        self.model.train()\n",
    "        self._update_lr()\n",
    "\n",
    "        with autocast(\"cuda\", dtype=torch.float16):\n",
    "            loss = self.compute_loss(\n",
    "                batch[\"image\"],\n",
    "                batch[\"question\"],\n",
    "                batch[\"reasoning\"],\n",
    "                batch[\"answer\"]\n",
    "            )\n",
    "\n",
    "        self.optimizer.zero_grad()\n",
    "        self.scaler.scale(loss).backward()\n",
    "\n",
    "        self.scaler.unscale_(self.optimizer)\n",
    "        torch.nn.utils.clip_grad_norm_(\n",
    "            [p for p in self.model.parameters() if p.requires_grad],\n",
    "            max_norm=self.config[\"max_grad_norm\"]\n",
    "        )\n",
    "\n",
    "        self.scaler.step(self.optimizer)\n",
    "        self.scaler.update()\n",
    "\n",
    "        self.current_step += 1\n",
    "        return loss.item()\n",
    "\n",
    "    def save(self, save_path: Path):\n",
    "        \"\"\"Save model checkpoint (LoRA weights only).\"\"\"\n",
    "        save_path = Path(save_path)\n",
    "        save_path.mkdir(parents=True, exist_ok=True)\n",
    "        \n",
    "        # Save LoRA weights\n",
    "        self.model.save_pretrained(save_path)\n",
    "        print(f\"✅ Saved LoRA weights to {save_path}\")\n",
    "        \n",
    "        # Optionally save training state\n",
    "        checkpoint = {\n",
    "            'step': self.current_step,\n",
    "            'optimizer_state': self.optimizer.state_dict(),\n",
    "            'scaler_state': self.scaler.state_dict(),\n",
    "            'config': self.config\n",
    "        }\n",
    "        torch.save(checkpoint, save_path / \"training_state.pt\")\n",
    "        print(f\"✅ Saved training state to {save_path / 'training_state.pt'}\")\n",
    "\n",
    "    def load(self, load_path: Path):\n",
    "        \"\"\"Load training state (optional, for resuming training).\"\"\"\n",
    "        load_path = Path(load_path)\n",
    "        checkpoint_file = load_path / \"training_state.pt\"\n",
    "        \n",
    "        if checkpoint_file.exists():\n",
    "            checkpoint = torch.load(checkpoint_file)\n",
    "            self.current_step = checkpoint['step']\n",
    "            self.optimizer.load_state_dict(checkpoint['optimizer_state'])\n",
    "            self.scaler.load_state_dict(checkpoint['scaler_state'])\n",
    "            print(f\"✅ Loaded training state from {checkpoint_file}\")\n",
    "        else:\n",
    "            print(f\"⚠️ No training state found at {checkpoint_file}\")\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def generate(self, image, question: str, max_tokens: int = 256) -> str:\n",
    "        \"\"\"Generate with same prompt format as training.\"\"\"\n",
    "        self.model.eval()\n",
    "    \n",
    "        image_embeds = self.model.encode_image(image)\n",
    "    \n",
    "        # MUST MATCH TRAINING PROMPT\n",
    "        prompt = f\"\\n\\nQuestion: {question}\\n\\nLet me analyze this step by step.\\n\\n\"\n",
    "        input_ids = self.tokenizer.encode(prompt, add_special_tokens=False)\n",
    "    \n",
    "        embed_layer = self.model.text_model.get_input_embeddings()\n",
    "        if hasattr(embed_layer, 'base_layer'):\n",
    "            embed_layer = embed_layer.base_layer\n",
    "    \n",
    "        generated = []\n",
    "    \n",
    "        for _ in range(max_tokens):\n",
    "            all_ids = input_ids + generated\n",
    "            ids_tensor = torch.tensor([all_ids], device=self.device)\n",
    "            text_embeds = embed_layer(ids_tensor)\n",
    "            inputs_embeds = torch.cat([image_embeds, text_embeds], dim=1)\n",
    "    \n",
    "            outputs = self.model.text_model(inputs_embeds=inputs_embeds)\n",
    "            logits = outputs.logits[0, -1, :]\n",
    "            next_token = torch.argmax(logits).item()\n",
    "    \n",
    "            if next_token == self.tokenizer.eos_token_id:\n",
    "                break\n",
    "    \n",
    "            generated.append(next_token)\n",
    "    \n",
    "            # Stop after </answer> tag\n",
    "            current_text = self.tokenizer.decode(generated)\n",
    "            if \"</answer>\" in current_text:\n",
    "                break\n",
    "    \n",
    "        return self.tokenizer.decode(generated, skip_special_tokens=True)\n",
    "\n",
    "trainer = MoondreamTrainer(model, tokenizer, CONFIG)"
   ]
  },
