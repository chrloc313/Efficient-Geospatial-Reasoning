    "synth_geocot_ann = load_json(Path(\"data\") / \"synth-geo-cot-dataset-final.json\")\n",
    "print(f\"Annotations: Train={len(train_ann)} | Val={len(val_ann)} | Test={len(test_ann)}\")\n",
    "print(f\"Synth Geo-CoT: {len(synth_geocot_ann)}\")\n",
