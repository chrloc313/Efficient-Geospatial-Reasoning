   "source": [
    "def collate_fn_geocot(batch):\n",
    "    \"\"\"Collate function for Geo-CoT dataset with structured reasoning.\"\"\"\n",
    "    return {\n",
    "        \"image\": [item[\"image\"] for item in batch],\n",
    "        \"question\": [item[\"question\"] for item in batch],\n",
    "        \"answer\": [item[\"answer\"] for item in batch],\n",
    "        \"type\": [item[\"type\"] for item in batch],\n",
    "        \"image_id\": [item[\"image_id\"] for item in batch],\n",
    "        \"question_id\": [item[\"question_id\"] for item in batch],\n",
    "        \n",
    "        # Geo-CoT structured reasoning\n",
    "        \"planning\": [item[\"planning\"] for item in batch],\n",
    "        \"grounding\": [item[\"grounding\"] for item in batch],\n",
    "        \"synthesis\": [item[\"synthesis\"] for item in batch],\n",
    "        \"raw_response\": [item[\"raw_response\"] for item in batch]\n",
    "    }\n",
    "\n",
    "def format_geocot_prompt(question: str, planning: dict, grounding: dict, synthesis: dict) -> str:\n",
    "    \"\"\"\n",
    "    Format Geo-CoT reasoning with <think>/<answer> tags and coordinate grounding.\n",
    "    Follows RSThinker paper format.\n",
    "    \"\"\"\n",
    "    # === PLANNING ===\n",
    "    planning_text = \"(Planning) \"\n",
    "    if planning.get('question_analysis'):\n",
    "        planning_text += f\"{planning['question_analysis']} \"\n",
    "    \n",
    "    regions = planning.get('relevant_regions', [])\n",
    "    if regions:\n",
    "        if isinstance(regions, list):\n",
    "            regions_str = \", \".join(regions)\n",
    "        else:\n",
    "            regions_str = str(regions)\n",
    "        planning_text += f\"I will examine: {regions_str}. \"\n",
    "    \n",
    "    if planning.get('reasoning_strategy'):\n",
    "        planning_text += f\"Strategy: {planning['reasoning_strategy']}\"\n",
    "    \n",
    "    # === GROUNDING (with coordinates) ===\n",
    "    grounding_text = \"(Grounding) \"\n",
    "    objects = grounding.get('objects', [])\n",
    "    if objects:\n",
    "        grounding_text += \"Upon inspection, I identify: \"\n",
    "        obj_parts = []\n",
    "        for obj in objects:\n",
    "            name = obj.get('object_name', obj.get('name', 'object'))\n",
    "            desc = obj.get('description', '')\n",
    "            \n",
    "            # Get bbox or convert location to bbox\n",
    "            bbox = obj.get('bbox', obj.get('bounding_box', None))\n",
    "            location = obj.get('approximate_location', obj.get('location', ''))\n",
    "            \n",
    "            if bbox:\n",
    "                coord_str = f\"[{bbox[0]}, {bbox[1]}, {bbox[2]}, {bbox[3]}]\"\n",
    "            elif location:\n",
    "                approx = location_to_approximate_bbox(location)\n",
    "                coord_str = f\"[{approx[0]}, {approx[1]}, {approx[2]}, {approx[3]}]\"\n",
    "            else:\n",
    "                coord_str = \"\"\n",
    "            \n",
    "            if coord_str:\n",
    "                obj_parts.append(f\"{name} {coord_str}: {desc}\")\n",
    "            else:\n",
    "                obj_parts.append(f\"{name}: {desc}\")\n",
    "        \n",
    "        grounding_text += \"; \".join(obj_parts) + \". \"\n",
    "    \n",
    "    spatial = grounding.get('spatial_relationships', [])\n",
    "    if spatial:\n",
    "        spatial_str = \" \".join(spatial) if isinstance(spatial, list) else str(spatial)\n",
    "        grounding_text += f\"Spatial analysis: {spatial_str} \"\n",
    "    \n",
    "    indicators = grounding.get('flood_indicators', [])\n",
    "    if indicators:\n",
    "        ind_str = \", \".join(indicators) if isinstance(indicators, list) else str(indicators)\n",
    "        grounding_text += f\"Key indicators: {ind_str}.\"\n",
    "    \n",
    "    # === SYNTHESIS ===\n",
    "    synthesis_text = \"(Synthesis) \"\n",
    "    observations = synthesis.get('observations', [])\n",
    "    if observations:\n",
    "        obs_str = \" \".join(observations) if isinstance(observations, list) else str(observations)\n",
    "        synthesis_text += f\"{obs_str} \"\n",
    "    \n",
    "    steps = synthesis.get('reasoning_steps', [])\n",
    "    if steps:\n",
    "        for i, step in enumerate(steps, 1):\n",
    "            synthesis_text += f\"({i}) {step} \"\n",
    "    \n",
    "    conclusion = synthesis.get('final_answer', '')\n",
    "    if conclusion:\n",
    "        synthesis_text += f\"Therefore, {conclusion}\"\n",
    "    \n",
    "    # === COMBINE WITH TAGS ===\n",
    "    return f\"\"\"<think>\n",
    "{planning_text.strip()}\n",
    "\n",
    "{grounding_text.strip()}\n",
    "\n",
    "{synthesis_text.strip()}\n",
    "</think>\"\"\"\n",
    "\n",
    "def train_geocot(trainer: MoondreamTrainer, train_dataset: Dataset, config: dict, \n",
    "                 use_full_reasoning: bool = True) -> List[dict]:\n",
    "    \"\"\"\n",
    "    Training loop for Geo-CoT dataset with structured reasoning.\n",
    "    \n",
    "    Args:\n",
    "        trainer: MoondreamTrainer instance\n",
    "        train_dataset: FloodNetGeoCOTDataset instance\n",
    "        config: Training configuration dict\n",
    "        use_full_reasoning: If True, use full Geo-CoT structure; if False, use concise format\n",
    "    \"\"\"\n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(\"STARTING GEO-COT TRAINING\")\n",
    "    print(f\"{'='*60}\")\n",
    "    print(f\"Epochs: {config['epochs']}\")\n",
    "    print(f\"Batch size: {config['batch_size']}\")\n",
    "    print(f\"Samples/epoch: {config['samples_per_epoch']}\")\n",
    "    print(f\"Total steps: ~{config['total_steps']}\")\n",
    "    print(f\"Reasoning format: {'Full' if use_full_reasoning else 'Concise'}\")\n",
    "    \n",
    "    history = []\n",
    "    \n",
    "    for epoch in range(1, config[\"epochs\"] + 1):\n",
    "        print(f\"\\n{'='*60}\")\n",
    "        print(f\"EPOCH {epoch}/{config['epochs']}\")\n",
    "        print(f\"{'='*60}\")\n",
    "        \n",
    "        # Subsample\n",
    "        if config[\"samples_per_epoch\"] < len(train_dataset):\n",
    "            indices = random.sample(range(len(train_dataset)), config[\"samples_per_epoch\"])\n",
    "            epoch_dataset = torch.utils.data.Subset(train_dataset, indices)\n",
    "        else:\n",
    "            epoch_dataset = train_dataset\n",
    "        \n",
    "        dataloader = DataLoader(\n",
    "            epoch_dataset,\n",
    "            batch_size=config[\"batch_size\"],\n",
    "            shuffle=True,\n",
    "            collate_fn=collate_fn_geocot,\n",
    "            num_workers=0\n",
    "        )\n",
    "        \n",
    "        epoch_losses = []\n",
    "        pbar = tqdm(dataloader, desc=f\"Epoch {epoch}\")\n",
    "        \n",
    "        for batch_idx, batch in enumerate(pbar):\n",
    "            # Format batch with Geo-CoT reasoning\n",
    "            formatted_batch = {\n",
    "                \"image\": batch[\"image\"],\n",
    "                \"question\": batch[\"question\"],\n",
    "                \"answer\": batch[\"answer\"],\n",
    "                \"type\": batch[\"type\"],\n",
    "                \"image_id\": batch[\"image_id\"]\n",
    "            }\n",
    "            \n",
    "            # Add formatted reasoning to the batch\n",
    "            formatted_batch[\"reasoning\"] = [\n",
    "                format_geocot_prompt(q, p, g, s)\n",
    "                for q, p, g, s in zip(\n",
    "                    batch[\"question\"],\n",
    "                    batch[\"planning\"],\n",
    "                    batch[\"grounding\"],\n",
    "                    batch[\"synthesis\"]\n",
    "                )\n",
    "            ]\n",
    "            \n",
    "            # Print first batch example\n",
    "            if batch_idx == 0 and epoch == 1:\n",
    "                print(f\"\\n{'='*60}\")\n",
    "                print(\"EXAMPLE TRAINING SAMPLE:\")\n",
    "                print(f\"{'='*60}\")\n",
    "                print(f\"Question: {formatted_batch['question'][0]}\")\n",
    "                print(f\"\\nReasoning:\\n{formatted_batch['reasoning'][0][:500]}...\")\n",
    "                print(f\"\\nAnswer: {formatted_batch['answer'][0]}\")\n",
    "                print(f\"{'='*60}\\n\")\n",
    "            \n",
    "            # Train step\n",
    "            loss = trainer.train_step(formatted_batch)\n",
    "            epoch_losses.append(loss)\n",
    "            \n",
    "            avg_loss = np.mean(epoch_losses[-50:])\n",
    "            pbar.set_postfix({\n",
    "                \"loss\": f\"{loss:.4f}\",\n",
    "                \"avg\": f\"{avg_loss:.4f}\",\n",
    "                \"step\": trainer.current_step\n",
    "            })\n",
    "        \n",
    "        avg_loss = np.mean(epoch_losses)\n",
    "        print(f\"\\nEpoch {epoch}: avg_loss={avg_loss:.4f}, steps={trainer.current_step}\")\n",
    "        \n",
    "        history.append({\n",
    "            \"epoch\": epoch,\n",
    "            \"avg_loss\": float(avg_loss),\n",
    "            \"steps\": trainer.current_step\n",
    "        })\n",
    "        \n",
    "        # Save checkpoint every epoch\n",
    "        if epoch % config.get(\"save_every\", 1) == 0:\n",
    "            checkpoint_path = Path(config.get(\"checkpoint_dir\", \"checkpoints\")) / f\"geocot_epoch_{epoch}\"\n",
    "            checkpoint_path.mkdir(parents=True, exist_ok=True)\n",
    "            trainer.save(checkpoint_path)\n",
    "            print(f\"✅ Saved checkpoint to {checkpoint_path}\")\n",
    "        \n",
    "        torch.cuda.empty_cache()\n",
    "    \n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"GEO-COT TRAINING COMPLETE (step {trainer.current_step})\")\n",
    "    print(f\"{'='*60}\")\n",
    "    \n",
    "    return history\n",
    "\n",
    "print(\"Geo-CoT training functions defined!\")"
   ]
  },
